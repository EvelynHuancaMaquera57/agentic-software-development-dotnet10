<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Snap</RootNamespace>
    <!-- Equivalente a TypeScript "strict": nulabilidad obligatoria y advertencias tratadas como errores -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- Validación de tokens JWT (incluye JsonWebTokenHandler para emitirlos) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <!-- Acceso directo a SQLite (ADO.NET), sin ORM -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los scripts SQL viajan dentro del ensamblado y se ejecutan en orden al arrancar -->
    <EmbeddedResource Include="Data\Scripts\*.sql" LogicalName="Snap.Data.Scripts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
